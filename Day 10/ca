<!DOCTYPE html>
<html lang="en">
<head>
    
    <title>Profile Card</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="profile-card">
    <img src="https://www.pngall.com/wp-content/uploads/5/User-Profile-PNG-Picture.png" alt="Profile Photo" class="profile-img">

    <h2>John Doe</h2>

    <p class="bio">
        A passionate web developer who loves building interactive websites.
    </p>

    <div class="contact">
        <p>📧 john.doe@example.com</p>
        <p>📞 +91-9876543210</p>
    </div>
</div>

</body>
</html>


body {
  margin: 0;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #eaeaea;
  font-family: Arial, Helvetica, sans-serif;
}

.profile-card {
  background: #ffffff;
  width: 320px;
  padding: 25px;
  border-radius: 12px;
  text-align: center;
  box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
}

.profile-img {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  object-fit: cover;
  border: 4px solid #4CAF50;
  margin-bottom: 15px;
}

.profile-card h2 {
  margin: 10px 0;
  color: #333;
}

.bio {
  font-size: 14px;
  color: #666;
  margin-bottom: 15px;
}

.contact p {
  font-size: 14px;
  color: #444;
  margin: 6px 0;
}